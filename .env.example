# =====================================================================
# Required: OpenAI
# Used for chat, evaluation, embeddings, and (optionally) web search.
# =====================================================================
OPENAI_API_KEY=

# =====================================================================
# Required: Supabase (Auth + database)
# Get these from your Supabase project Settings → API.
# =====================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site origin used for OAuth redirects. Use http://localhost:3000 in dev,
# the deployed domain in production. Must also be added to Supabase →
# Authentication → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =====================================================================
# Optional: Alumni discovery
# =====================================================================
EXA_API_KEY=

# =====================================================================
# Optional: Scholarship scraping pipeline (npm run db:seed)
# =====================================================================
INTERFAZE_API_KEY=

# =====================================================================
# Optional: Model overrides — defaults shown below.
# =====================================================================
# OPENAI_CHAT_MODEL=gpt-5.4-mini
# OPENAI_EVALUATE_MODEL=gpt-5.4-mini
# OPENAI_ALUMNI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_SCRAPE_MODEL=gpt-5.4-mini
# SCHOLARSHIP_SCRAPE_PROVIDER=interfaze
# SCHOLARSHIPS_PER_SOURCE=10
# INTERFAZE_MODEL=interfaze-beta
